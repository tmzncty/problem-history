{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem Episode M0 experimental schema",
  "description": "Structural prototype, not historical truth validation. No automatic identity adjudication. Fictional fixtures are not evidence.",
  "type": "object",
  "required": [
    "episode",
    "problem_formulations",
    "sources",
    "claims",
    "uncertainty"
  ],
  "properties": {
    "episode": {
      "type": "object",
      "required": [
        "id",
        "time_range",
        "place_or_institution",
        "episode_unit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "time_range": {
          "type": "string",
          "minLength": 1
        },
        "place_or_institution": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "episode_unit": {
          "enum": [
            "author_text",
            "exchange",
            "debate",
            "institutional_process",
            "mixed"
          ]
        }
      },
      "additionalProperties": false
    },
    "problem_formulations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "text",
          "evidence",
          "confidence"
        ],
        "properties": {
          "type": {
            "enum": [
              "explicit_actor",
              "reconstructed_actor",
              "researcher_analytic"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "relation",
                "directness",
                "locator"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "enum": [
                    "supports",
                    "contradicts",
                    "complicates",
                    "contextualizes",
                    "dates",
                    "locates",
                    "transmits",
                    "later_reinterprets"
                  ]
                },
                "directness": {
                  "enum": [
                    "explicit",
                    "inferential",
                    "contextual"
                  ]
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "undetermined"
            ]
          },
          "actor_language": {
            "enum": [
              "supported",
              "contested",
              "unsupported",
              "undetermined"
            ]
          },
          "competing_readings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "reconstructed_actor"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "actor_language",
                "competing_readings"
              ]
            }
          }
        ]
      }
    },
    "structure": {
      "type": "object",
      "properties": {
        "target_object": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stakes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "presuppositions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer_space": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "problem_responsibility": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "object_status_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "properties": {
        "opponents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rival_formulations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uptake_or_reply": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "askability": {
      "type": "object",
      "required": [
        "status",
        "supporting_conditions",
        "blocking_conditions"
      ],
      "properties": {
        "status": {
          "enum": [
            "askable",
            "contested",
            "weakened",
            "displaced",
            "became_unaskable",
            "revived",
            "undetermined"
          ]
        },
        "supporting_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocking_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "positive_transition_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "identity",
          "version",
          "locator",
          "provenance",
          "digital_representation"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "object",
            "required": [
              "creator",
              "title",
              "original_date",
              "source_type"
            ],
            "properties": {
              "creator": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "original_date": {
                "type": "string"
              },
              "source_type": {
                "type": "string"
              },
              "language": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "version": {
            "type": "object",
            "required": [
              "edition_or_version"
            ],
            "properties": {
              "edition_or_version": {
                "type": "string"
              },
              "edition_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "translator": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "locator": {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "page",
                  "folio",
                  "paragraph",
                  "section",
                  "column",
                  "item",
                  "file",
                  "timecode",
                  "image",
                  "canvas",
                  "other"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          },
          "provenance": {
            "type": "object",
            "required": [
              "repository_or_host",
              "url",
              "accessed"
            ],
            "properties": {
              "repository_or_host": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string"
              },
              "accessed": {
                "type": "string"
              },
              "stable_identifier": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "digital_representation": {
            "type": "object",
            "required": [
              "mode",
              "facsimile_checked",
              "ocr_only"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "facsimile",
                  "diplomatic_transcription",
                  "edited_transcription",
                  "html",
                  "ocr",
                  "born_digital",
                  "audio",
                  "video",
                  "other"
                ]
              },
              "facsimile_checked": {
                "enum": [
                  true,
                  false,
                  "not_applicable"
                ]
              },
              "ocr_only": {
                "type": "boolean"
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "layer",
          "source_links",
          "evidence_assessment"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "actor_explicit",
              "actor_reconstructed",
              "researcher_analytic"
            ]
          },
          "source_links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "relation",
                "directness",
                "locator"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "enum": [
                    "supports",
                    "contradicts",
                    "complicates",
                    "contextualizes",
                    "dates",
                    "locates",
                    "transmits",
                    "later_reinterprets"
                  ]
                },
                "directness": {
                  "enum": [
                    "explicit",
                    "inferential",
                    "contextual"
                  ]
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "evidence_assessment": {
            "type": "object",
            "required": [
              "overall_for_this_claim",
              "note"
            ],
            "properties": {
              "overall_for_this_claim": {
                "enum": [
                  "strong",
                  "medium",
                  "weak",
                  "lead_only"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "to_episode",
          "relation",
          "status",
          "continuity_evidence",
          "discontinuity_evidence",
          "checks"
        ],
        "properties": {
          "to_episode": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "continuous",
              "reformulated",
              "transformed_successor",
              "split",
              "merged",
              "displaced",
              "revived",
              "analogy_only",
              "unrelated",
              "undetermined"
            ]
          },
          "status": {
            "enum": [
              "provisional",
              "supported",
              "undetermined"
            ]
          },
          "continuity_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "discontinuity_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checks": {
            "type": "object",
            "required": [
              "target_object",
              "stakes",
              "presuppositions",
              "answer_space",
              "historical_recognition",
              "askability"
            ],
            "properties": {
              "target_object": {
                "type": "string"
              },
              "stakes": {
                "type": "string"
              },
              "presuppositions": {
                "type": "string"
              },
              "answer_space": {
                "type": "string"
              },
              "historical_recognition": {
                "type": "string"
              },
              "askability": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "competing_reconstructions",
        "evidence_gaps",
        "hindsight_risks"
      ],
      "properties": {
        "competing_reconstructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hindsight_risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "research_status": {
      "enum": [
        "candidate",
        "evidence_gap",
        "undetermined",
        "provisional",
        "supported"
      ]
    }
  },
  "additionalProperties": false
}
